# Copy to profilesite.env, fill in the blanks, then run install-service.ps1.
#
# profilesite.env is gitignored. It holds real secrets, so it never gets
# committed, pasted into a chat, or copied off this machine.
#
# Format: KEY=VALUE, one per line. Everything after the first '=' is the value,
# so hashes containing '=' padding are safe. No quoting, no escapes - a value is
# taken literally to the end of the line. Blank lines and #-comments ignored.
#
# The double underscore is ASP.NET's separator for nested config keys:
# Admin__PasswordHash sets the "Admin:PasswordHash" setting.

# ---- hosting ----
ASPNETCORE_ENVIRONMENT=Production

# Bind loopback only. The tunnel reaches the app from this machine; nothing
# else can, which is what removes the need for an open inbound port.
ASPNETCORE_URLS=http://127.0.0.1:8080

# Without this ASP.NET cannot work out where to redirect to and silently skips
# UseHttpsRedirection ("Failed to determine the https port for redirect").
ASPNETCORE_HTTPS_PORT=443

# Only cloudflared can reach the app, and it connects over loopback, so this is
# the complete set of senders allowed to set the client IP via X-Forwarded-For.
# Anyone trusted here can forge that header and evade the contact-form rate
# limiter, which is why the list is this short.
ForwardedHeaders__KnownProxies__0=127.0.0.1
ForwardedHeaders__KnownProxies__1=::1

# ---- state ----
# Everything that must survive a redeploy lives under the data directory, which
# publish-selfhost.ps1 never touches. Match -Root if you changed it.
ConnectionStrings__Default=Data Source=C:\ProfileSite\data\app.db
Storage__UploadsRoot=C:\ProfileSite\data\uploads
Storage__DataProtectionKeys=C:\ProfileSite\data\keys

# ---- public origin ----
# Both indices are set because appsettings.json lists two localhost origins for
# dev; overriding only __0 would leave the https localhost entry live in
# production.
Cors__AllowedOrigins__0=https://tedko.dev
Cors__AllowedOrigins__1=https://www.tedko.dev

# Reject requests whose Host header is anything else. appsettings.json ships
# "*" so dev works on localhost; narrowing it here means a stray tunnel or a
# direct hit on 127.0.0.1:8080 cannot serve the site under another name.
AllowedHosts=tedko.dev;www.tedko.dev

# ---- secrets ----
# The two hashes are BCrypt, not the passwords themselves and not a SHA of
# them - the app verifies with BCrypt.Net.Verify. Generate each with:
#   .\deploy\new-hash.ps1
Admin__Username=admin
Admin__PasswordHash=
Private__PasscodeHash=

Email__SmtpHost=smtp.gmail.com
Email__SmtpPort=587
Email__SmtpUser=
Email__SmtpPassword=
Email__FromEmail=
Email__ToEmail=
